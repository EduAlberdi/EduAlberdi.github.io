---
import "../index.css";

interface Props {
  title?: string;
  description?: string;
  page?: string;
}

const {
  title = "Eduard Alberdi Marín — Senior Full-Stack Software Engineer",
  description = "Architecture with a human interface. Selected engineering work, experiments, and experience.",
  page = "home",
} = Astro.props;

const nav = [
  ["work", "Work"],
  ["about", "About"],
  ["experience", "CV"],
  ["talks", "Talks"],
  ["contact", "Contact"],
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#09090B" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <link rel="icon" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header>
      <a href="/" class="logo">EA<span>M</span></a>
      <nav aria-label="Primary" id="primary-navigation">
        {nav.map(([id, label]) => <a href={`/${id}`} class:list={{ active: page === id }}>{label}</a>)}
      </nav>
      <div class="status">
        <span>● Barcelona · CET</span>
        <button type="button" aria-expanded="false" aria-controls="primary-navigation">Menu</button>
      </div>
    </header>
    <main id="main"><slot /></main>
    <footer>
      <div><p class="eyebrow">Portfolio / 2025</p><strong>Eduard Alberdi Marín</strong></div>
      <div class="footlinks">
        <a href="/cv/">CV ↗</a>
        <a target="_blank" href="https://calendly.com/edu-alberdi">Calendly ↗</a>
        <a href="/contact">Contact →</a>
      </div>
      <small>Senior Full-Stack Software Engineer<br />Barcelona, Spain</small>
    </footer>
    <script>
      const button = document.querySelector<HTMLButtonElement>(".status button");
      const navigation = document.querySelector<HTMLElement>("#primary-navigation");
      button?.addEventListener("click", () => {
        const open = button.getAttribute("aria-expanded") === "true";
        button.setAttribute("aria-expanded", String(!open));
        button.textContent = open ? "Menu" : "Close";
        navigation?.classList.toggle("open", !open);
      });

      const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      if (!reduceMotion) {
        document.documentElement.classList.add("motion-ready");
        const hero = document.querySelector<HTMLElement>(".hero");
        hero?.addEventListener("pointermove", (event) => {
          const bounds = hero.getBoundingClientRect();
          const x = ((event.clientX - bounds.left) / bounds.width) - 0.5;
          const y = ((event.clientY - bounds.top) / bounds.height) - 0.5;
          hero.style.setProperty("--mx", `${x * 24}px`);
          hero.style.setProperty("--my", `${y * 18}px`);
          hero.style.setProperty("--ox", `${x * -13}px`);
          hero.style.setProperty("--oy", `${y * -10}px`);
        });
        hero?.addEventListener("pointerleave", () => {
          hero.style.setProperty("--mx", "0px");
          hero.style.setProperty("--my", "0px");
          hero.style.setProperty("--ox", "0px");
          hero.style.setProperty("--oy", "0px");
        });

        const revealItems = document.querySelectorAll(".project, .story, .trio article, .quad article, .talk-list article");
        const observer = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add("is-visible");
              observer.unobserve(entry.target);
            }
          });
        }, { threshold: 0.12, rootMargin: "0px 0px -8% 0px" });
        revealItems.forEach((item, index) => {
          item.classList.add("reveal-item");
          item.setAttribute("data-reveal-order", String(index % 3));
          observer.observe(item);
        });
      }
    </script>
  </body>
</html>
