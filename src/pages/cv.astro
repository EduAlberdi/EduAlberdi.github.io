---
import About from "@/components/cv_sections/About.astro";
import Education from "@/components/cv_sections/Education.astro";
import Experience from "@/components/cv_sections/Experience.astro";
import Hero from "@/components/cv_sections/Hero.astro";
import Skills from "@/components/cv_sections/Skills.astro";
import Layout from "@/layouts/Layout.astro";

import { basics } from "@cv";
const { name } = basics;
const title = `${name.split(" ")[0]}'s CV`;
---

<Layout title={`${title} — Eduard Alberdi Marín`}>
    <main>
        <Hero />
        <About />
        <Experience />
        <Education />
        <Skills />
    </main>
</Layout>

<style is:global>
    :root {
        --accent: 136, 58, 234;
        --accent-light: 224, 204, 250;
        --accent-dark: 49, 10, 101;
        --accent-gradient: linear-gradient(
            45deg,
            rgb(var(--accent)),
            rgb(var(--accent-light)) 30%,
            white 60%
        );
    }
    html {
        font-family: system-ui, sans-serif;
        background-size: 224px;
        font-family:var(--mono)
    }
    code {
        font-family:
            Menlo,
            Monaco,
            Lucida Console,
            Liberation Mono,
            DejaVu Sans Mono,
            Bitstream Vera Sans Mono,
            Courier New,
            monospace;
    }
    main {
        margin: auto;
        width: 100%;
        background-color: whitesmoke;
        color: black;
        padding: 2rem 0;
    }
</style>
